{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests"]
}
